@{
    ViewData["Title"] = "CashAdmin Dashboard";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-12">
            <h1 class="fw-bold mb-4">CashAdmin Dashboard</h1>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-wallet2 text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Top-up Student Wallet</h5>
                    <p class="card-text text-muted small">Search student by ID and add balance to their wallet.</p>
                    <a href="@Url.Action("TopUpWallet", "CashAdmin")" class="btn btn-primary btn-sm">Top-up Wallet</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-receipt text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Cash Settlement</h5>
                    <p class="card-text text-muted small">View and manage cash collection records.</p>
                    <a href="#" class="btn btn-primary btn-sm disabled">View Settlement</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-graph-up text-primary" style="font-size: 2rem;"></i>
                    </div>
                    <h5 class="card-title fw-bold">Reports</h5>
                    <p class="card-text text-muted small">View cash collection and transaction reports.</p>
                    <a href="@Url.Action("Reports", "CashAdmin")" class="btn btn-primary btn-sm">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>
