@model List<MealSession>

@{
    ViewData["Title"] = "Meals";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="fw-bold">Operational Meals</h1>
                <div>
                    <a href="@Url.Action("MealHistory", "Admin")" class="btn btn-outline-secondary me-2">View Meal History</a>
                    <a href="@Url.Action("CreateMeal", "Admin")" class="btn btn-primary">+ Create Meal</a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="row mb-3">
            <div class="col-lg-12">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="row mb-3">
            <div class="col-lg-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="row mb-3">
            <div class="col-lg-12">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @if (Model?.Count > 0)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="table-responsive">
                    <table class="table table-hover border rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th>Meal Name</th>
                                <th>Price</th>
                                <th>Sale Start</th>
                                <th>Serving End</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meal in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@meal.Name</td>
                                    <td>৳@meal.Price.ToString("N0")</td>
                                    <td>@meal.TokenSellStartDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>@meal.MealServingEndDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        @{
                                            var status = MealDetailsViewModel.GetMealStatus(
                                                meal.TokenSellStartDateTime,
                                                meal.TokenSellEndDateTime,
                                                meal.MealServingStartDateTime,
                                                meal.MealServingEndDateTime,
                                                meal.IsArchived);

                                            string badgeClass = status switch
                                            {
                                                "Upcoming" => "bg-secondary",
                                                "Sale Open" => "bg-success",
                                                "Sale Closed" => "bg-warning",
                                                "Serving" => "bg-primary",
                                                "Completed" => "bg-danger",
                                                "Archived" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@status</span>
                                    </td>
                                    <td class="text-muted small">@meal.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @{
                                            bool isExpired = DateTime.Now > meal.MealServingEndDateTime;
                                            bool isUpcoming = DateTime.Now < meal.TokenSellStartDateTime;
                                            var soldCount = meal.SoldCount;
                                        }
                                        @if (isExpired)
                                        {
                                            <button class="btn btn-sm btn-secondary" disabled title="Cannot edit expired meals">Edit</button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="EditMeal"
                                               asp-route-id="@meal.Id"
                                               class="btn btn-sm btn-primary">
                                                Edit
                                            </a>
                                        }

                                        @if (isUpcoming && soldCount == 0)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ArchiveMeal"
                                                  asp-route-id="@meal.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Archive this meal? It will be hidden from the meal list.');">
                                                    Archive
                                                </button>
                                            </form>
                                        }

                                        <a asp-controller="Admin"
                                           asp-action="MealDetails"
                                           asp-route-id="@meal.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="View meal details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
                        <p class="text-muted mt-3">No operational meals at this time.</p>
                        <div class="mt-3">
                            <a href="@Url.Action("CreateMeal", "Admin")" class="btn btn-primary btn-sm me-2">Create Meal</a>
                            <a href="@Url.Action("MealHistory", "Admin")" class="btn btn-outline-secondary btn-sm">View History</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-4">
        <div class="col-lg-12">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">← Back to Dashboard</a>
        </div>
    </div>
</div>
