@model List<SettlementRequestItemViewModel>

@{
    ViewData["Title"] = "Settlement Requests";
}

<div class="container-fluid py-5">
    <div class="row mb-5">
        <div class="col-lg-12">
            <h1 class="fw-bold">Settlement Requests</h1>
            <p class="text-muted">Review and approve/reject CashAdmin settlement requests.</p>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-light border-0 rounded-top-3 p-3">
                        <h5 class="fw-bold mb-0">
                            Pending Requests
                            <span class="badge bg-warning">@Model.Count</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>CashAdmin Name</th>
                                        <th>CashAdmin Email</th>
                                        <th>Requested Amount</th>
                                        <th>Requested At</th>
                                        <th>Request Note</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold">@request.CashAdminName</td>
                                            <td class="small">@request.CashAdminEmail</td>
                                            <td class="fw-bold">৳@request.Amount.ToString("N2")</td>
                                            <td class="small text-muted">@request.RequestedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(request.RequestNote))
                                                {
                                                    <span class="badge bg-info">@request.RequestNote</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <!-- Approve Button -->
                                                    <button type="button" class="btn btn-success" data-bs-toggle="modal" 
                                                            data-bs-target="#approveModal@(request.Id)">
                                                        <i class="bi bi-check-circle"></i> Approve
                                                    </button>

                                                    <!-- Reject Button -->
                                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" 
                                                            data-bs-target="#rejectModal@(request.Id)">
                                                        <i class="bi bi-x-circle"></i> Reject
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Approve Modal -->
                                        <div class="modal fade" id="approveModal@(request.Id)" tabindex="-1" aria-labelledby="approveLabel@(request.Id)" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="approveLabel@(request.Id)">Approve Settlement Request</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form method="post" asp-controller="Admin" asp-action="ApproveSettlement">
                                                        <div class="modal-body">
                                                            <p class="mb-3">Approve settlement request from <strong>@request.CashAdminName</strong> for <strong>৳@request.Amount.ToString("N2")</strong>?</p>
                                                            <input type="hidden" name="requestId" value="@request.Id" />
                                                            <div class="mb-3">
                                                                <label for="adminNote@(request.Id)" class="form-label">Admin Note (Optional)</label>
                                                                <textarea id="adminNote@(request.Id)" name="adminNote" class="form-control" 
                                                                          rows="2" placeholder="Optional note"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success">
                                                                <i class="bi bi-check-circle"></i> Approve Request
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal@(request.Id)" tabindex="-1" aria-labelledby="rejectLabel@(request.Id)" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="rejectLabel@(request.Id)">Reject Settlement Request</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form method="post" asp-controller="Admin" asp-action="RejectSettlement">
                                                        <div class="modal-body">
                                                            <p class="mb-3">Reject settlement request from <strong>@request.CashAdminName</strong> for <strong>৳@request.Amount.ToString("N2")</strong>?</p>
                                                            <input type="hidden" name="requestId" value="@request.Id" />
                                                            <div class="mb-3">
                                                                <label for="rejectNote@(request.Id)" class="form-label">Rejection Reason <span class="text-danger">*</span></label>
                                                                <textarea id="rejectNote@(request.Id)" name="adminNote" class="form-control" 
                                                                          rows="3" placeholder="Please provide a reason for rejection" required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">
                                                                <i class="bi bi-x-circle"></i> Reject Request
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3 fs-5">No pending settlement requests.</p>
                    <p class="text-muted">All settlement requests have been reviewed.</p>
                </div>
            </div>
        </div>
    }

    <!-- Back Button -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">← Back to Dashboard</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
