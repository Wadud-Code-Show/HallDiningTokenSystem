@model CreateMealViewModel

@{
    ViewData["Title"] = "Create Meal";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-lg-8 mx-auto">
            <h1 class="fw-bold mb-2">Create New Meal</h1>
            <p class="text-muted">Add a new meal session to the system.</p>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="row mb-3">
            <div class="col-lg-8 mx-auto">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="CreateMeal" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="MealName" class="form-label fw-bold"></label>
                            <input asp-for="MealName" class="form-control" placeholder="e.g., Breakfast, Lunch, Dinner" />
                            <span asp-validation-for="MealName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MealType" class="form-label fw-bold"></label>
                            <input asp-for="MealType" class="form-control" placeholder="e.g., Vegetarian, Non-Vegetarian" />
                            <span asp-validation-for="MealType" class="text-danger small"></span>
                        </div>

                        <!-- Token Purchase Phase -->
                        <div class="card border-start border-success border-3 bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-success mb-3">Token Purchase Phase</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="TokenSellStartDateTime" class="form-label fw-bold"></label>
                                            <input asp-for="TokenSellStartDateTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="TokenSellStartDateTime" class="text-danger small"></span>
                                            <small class="text-muted d-block mt-1">When students can start buying tokens.</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="TokenSellEndDateTime" class="form-label fw-bold"></label>
                                            <input asp-for="TokenSellEndDateTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="TokenSellEndDateTime" class="text-danger small"></span>
                                            <small class="text-muted d-block mt-1">When token purchasing closes.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Meal Serving Phase -->
                        <div class="card border-start border-primary border-3 bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title fw-bold text-primary mb-3">Meal Serving Phase</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="MealServingStartDateTime" class="form-label fw-bold"></label>
                                            <input asp-for="MealServingStartDateTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="MealServingStartDateTime" class="text-danger small"></span>
                                            <small class="text-muted d-block mt-1">When meal collection starts.</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="MealServingEndDateTime" class="form-label fw-bold"></label>
                                            <input asp-for="MealServingEndDateTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="MealServingEndDateTime" class="text-danger small"></span>
                                            <small class="text-muted d-block mt-1">When meal collection closes.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label fw-bold"></label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Capacity" class="form-label fw-bold"></label>
                                    <input asp-for="Capacity" type="number" class="form-control" placeholder="Number of meals" />
                                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional meal description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Create Meal</button>
                            <a href="@Url.Action("Meals", "Admin")" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
