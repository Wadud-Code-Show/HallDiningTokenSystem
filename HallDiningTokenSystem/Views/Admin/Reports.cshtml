@model AdminReportViewModel

@{
    ViewData["Title"] = "System Reports";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">System Reports</h1>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Students</h6>
                    <h3 class="card-title">@Model.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total CashAdmins</h6>
                    <h3 class="card-title">@Model.TotalCashAdmins</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Meals</h6>
                    <h3 class="card-title">@Model.TotalMeals</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Tokens Sold</h6>
                    <h3 class="card-title">@Model.TotalTokensSold</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Cash Flow Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Cash Collected</h6>
                    <h3 class="card-title">৳@Model.TotalCashCollected.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 bg-light">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Cash Settled</h6>
                    <h3 class="card-title">৳@Model.TotalCashSettled.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 bg-warning">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Pending Cash</h6>
                    <h3 class="card-title">৳@Model.PendingCash.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100 bg-info text-white">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2">Pending Requests</h6>
                    <h3 class="card-title">@Model.PendingSettlementRequests</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- CashAdmin-wise Summary Table -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">CashAdmin Summary</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>CashAdmin Name</th>
                                    <th>Email</th>
                                    <th class="text-end">Total Collected</th>
                                    <th class="text-end">Total Settled</th>
                                    <th class="text-end">Pending Cash</th>
                                    <th class="text-end">Pending Requests</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CashAdminSummary.Any())
                                {
                                    @foreach (var admin in Model.CashAdminSummary)
                                    {
                                        <tr>
                                            <td>@admin.CashAdminName</td>
                                            <td>@admin.CashAdminEmail</td>
                                            <td class="text-end">৳@admin.TotalCollected.ToString("N2")</td>
                                            <td class="text-end">৳@admin.TotalSettled.ToString("N2")</td>
                                            <td class="text-end">
                                                <span class="badge bg-warning text-dark">
                                                    ৳@admin.PendingCash.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (admin.PendingRequestsAmount > 0)
                                                {
                                                    <span class="badge bg-info">
                                                        ৳@admin.PendingRequestsAmount.ToString("N2")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No CashAdmin data available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Cash Collections -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Cash Collections (Last 10)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date/Time</th>
                                    <th>CashAdmin</th>
                                    <th>Student Name</th>
                                    <th>Student ID</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentCollections.Any())
                                {
                                    @foreach (var collection in Model.RecentCollections)
                                    {
                                        <tr>
                                            <td>@collection.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@collection.CashAdminName</td>
                                            <td>@collection.StudentName</td>
                                            <td>@collection.StudentId</td>
                                            <td class="text-end">৳@collection.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No recent collections</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Settlement Requests -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Settlement Requests (Last 10)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date/Time</th>
                                    <th>CashAdmin</th>
                                    <th class="text-end">Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentSettlementRequests.Any())
                                {
                                    @foreach (var request in Model.RecentSettlementRequests)
                                    {
                                        <tr>
                                            <td>@request.RequestedAt.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@request.CashAdminName</td>
                                            <td class="text-end">৳@request.Amount.ToString("N2")</td>
                                            <td>
                                                @if (request.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">@request.Status</span>
                                                }
                                                else if (request.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">@request.Status</span>
                                                }
                                                else if (request.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">@request.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No recent requests</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Confirmed Settlements -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Confirmed Settlements (Last 10)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Date/Time</th>
                                    <th>CashAdmin</th>
                                    <th class="text-end">Amount</th>
                                    <th>Received By</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentSettlements.Any())
                                {
                                    @foreach (var settlement in Model.RecentSettlements)
                                    {
                                        <tr>
                                            <td>@settlement.SettlementDate.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>@settlement.CashAdminName</td>
                                            <td class="text-end">৳@settlement.Amount.ToString("N2")</td>
                                            <td>@settlement.ReceivedByAdminName</td>
                                            <td>@(string.IsNullOrEmpty(settlement.Note) ? "—" : settlement.Note)</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No recent settlements</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Meal Summary Table -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Meal Summary</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Meal Name</th>
                                    <th>Type</th>
                                    <th>Meal Date</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Capacity</th>
                                    <th class="text-end">Sold Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MealSummary.Any())
                                {
                                    @foreach (var meal in Model.MealSummary)
                                    {
                                        <tr>
                                            <td>@meal.MealName</td>
                                            <td>@meal.MealType</td>
                                            <td>@meal.TokenSellStartDateTime.ToString("dd MMM yyyy")</td>
                                            <td class="text-end">৳@meal.Price.ToString("N2")</td>
                                            <td class="text-end">@meal.Capacity</td>
                                            <td class="text-end">@meal.SoldCount</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">No meal data available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
