@model StudentReportViewModel

@{
    ViewData["Title"] = "Student Report";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Student Report</h1>
                    <p class="text-muted mb-0">Student activity and spending analysis</p>
                </div>
                <a href="@Url.Action("Dashboard", "Reports")" class="btn btn-outline-secondary">← Back</a>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row mb-4">
        <div class="col-lg-4 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Students</p>
                    <h3 class="fw-bold">@Model?.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Wallet Balance</p>
                    <h3 class="fw-bold">৳@Model?.TotalWalletBalance.ToString("N2")</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Spending</p>
                    <h3 class="fw-bold">৳@Model?.TotalSpending.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="row">
        <div class="col-lg-12">
            @if (Model?.Students == null || Model.Students.Count == 0)
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3 text-muted">No Students Found</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-bold">Student Name</th>
                                    <th class="fw-bold">Student ID</th>
                                    <th class="fw-bold">Wallet Balance</th>
                                    <th class="fw-bold">Purchased</th>
                                    <th class="fw-bold">Redeemed</th>
                                    <th class="fw-bold">Unredeemed</th>
                                    <th class="fw-bold">Total Spending</th>
                                    <th class="fw-bold">Redemption %</th>
                                    <th class="fw-bold">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Students)
                                {
                                    <tr>
                                        <td>@student.StudentName</td>
                                        <td>@student.StudentId</td>
                                        <td>
                                            <span class="fw-bold">৳@student.CurrentWalletBalance.ToString("N2")</span>
                                        </td>
                                        <td>@student.PurchasedTokensCount</td>
                                        <td>@student.RedeemedTokensCount</td>
                                        <td>@student.UnredeemedTokens</td>
                                        <td>৳@student.TotalSpending.ToString("N2")</td>
                                        <td>
                                            <span class="fw-bold">@student.RedemptionRate.ToString("N1")%</span>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("StudentDetails", "Reports", new { id = student.UserId })" class="btn btn-sm btn-primary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
