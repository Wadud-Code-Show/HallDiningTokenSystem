@model SettlementReportViewModel

@{
    ViewData["Title"] = "Settlement Report";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Settlement Report</h1>
                    <p class="text-muted mb-0">Cash admin collections and settlements</p>
                </div>
                <a href="@Url.Action("Dashboard", "Reports")" class="btn btn-outline-secondary">← Back</a>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row mb-4">
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Settlements</p>
                    <h3 class="fw-bold">@Model?.TotalSettlements</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Amount Settled</p>
                    <h3 class="fw-bold">৳@Model?.TotalAmountSettled.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Settlements Table -->
    <div class="row">
        <div class="col-lg-12">
            @if (Model?.Settlements == null || Model.Settlements.Count == 0)
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3 text-muted">No Settlements Found</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-bold">CashAdmin</th>
                                    <th class="fw-bold">Collection Date</th>
                                    <th class="fw-bold">Amount</th>
                                    <th class="fw-bold">Status</th>
                                    <th class="fw-bold">Settlement Date</th>
                                    <th class="fw-bold">Received By</th>
                                    <th class="fw-bold">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var settlement in Model.Settlements)
                                {
                                    <tr>
                                        <td>@settlement.CashAdminName</td>
                                        <td>@settlement.FormattedDate</td>
                                        <td><strong>৳@settlement.Amount.ToString("N2")</strong></td>
                                        <td>
                                            <span class="badge @settlement.StatusBadgeClass">@settlement.SettlementStatus</span>
                                        </td>
                                        <td>
                                            @if (settlement.SettlementDate.HasValue)
                                            {
                                                <span>@settlement.SettlementDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@settlement.ReceivedByAdminName</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(settlement.SettlementNotes))
                                            {
                                                <small>@settlement.SettlementNotes</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
