@model MealDetailsReportViewModel

@{
    ViewData["Title"] = "Meal Details - " + Model?.MealName;
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">@Model?.MealName</h1>
                    <p class="text-muted mb-0">Detailed meal analytics and student participation</p>
                </div>
                <a href="@Url.Action("Meals", "Reports")" class="btn btn-outline-secondary">← Back to Meals</a>
            </div>
        </div>
    </div>

    <!-- Meal Information -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Status</p>
                    <p class="fw-bold mb-0">
                        <span class="badge bg-info">@Model?.Status</span>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Price</p>
                    <h4 class="fw-bold">৳@Model?.Price.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Capacity</p>
                    <h4 class="fw-bold">@Model?.Capacity seats</h4>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Description</p>
                    <p class="mb-0 small">@Model?.MealDescription</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Token Statistics -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Token Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-6 mb-3">
                            <p class="text-muted small mb-1">Total Sold</p>
                            <h3 class="fw-bold text-success">@Model?.TotalSold</h3>
                        </div>
                        <div class="col-md-6 mb-3">
                            <p class="text-muted small mb-1">Total Redeemed</p>
                            <h3 class="fw-bold text-primary">@Model?.TotalRedeemed</h3>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Remaining Capacity</p>
                            <h3 class="fw-bold text-warning">@Model?.RemainingCapacity</h3>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Redemption Rate</p>
                            <h3 class="fw-bold">@Model?.RedemptionRate.ToString("N1")%</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Statistics -->
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Revenue Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-6 mb-3">
                            <p class="text-muted small mb-1">Total Revenue</p>
                            <h3 class="fw-bold">৳@Model?.TotalRevenue.ToString("N2")</h3>
                        </div>
                        <div class="col-md-6 mb-3">
                            <p class="text-muted small mb-1">Capacity Utilization</p>
                            <h3 class="fw-bold">@Model?.CapacityUtilization.ToString("N1")%</h3>
                        </div>
                        <div class="col-12">
                            <div class="progress" style="height: 25px;">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: @(Model?.CapacityUtilization)%;" 
                                     aria-valuenow="@Model?.TotalSold" aria-valuemin="0" aria-valuemax="@Model?.Capacity">
                                    @Model?.CapacityUtilization.ToString("N1")% Utilized
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Time Windows -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Token Purchase Phase</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-1">Sale Start</p>
                    <p class="fw-bold">@Model?.TokenSaleStart.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="text-muted small mb-1">Sale End</p>
                    <p class="fw-bold">@Model?.TokenSaleEnd.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Meal Serving Phase</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-1">Serving Start</p>
                    <p class="fw-bold">@Model?.ServingStart.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="text-muted small mb-1">Serving End</p>
                    <p class="fw-bold">@Model?.ServingEnd.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Participation Table -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Student Participation (@Model?.StudentParticipation.Count students)</h5>
                </div>
                @if (Model?.StudentParticipation == null || Model.StudentParticipation.Count == 0)
                {
                    <div class="card-body p-5 text-center">
                        <p class="text-muted">No students participated in this meal.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-bold">Student Name</th>
                                    <th class="fw-bold">Student ID</th>
                                    <th class="fw-bold">Purchase Date</th>
                                    <th class="fw-bold">Redeemed?</th>
                                    <th class="fw-bold">Redemption Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.StudentParticipation)
                                {
                                    <tr>
                                        <td>@student.StudentName</td>
                                        <td>@student.StudentId</td>
                                        <td>@student.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge @student.RedemptionBadgeClass">@student.RedeemedStatus</span>
                                        </td>
                                        <td>
                                            @if (student.IsRedeemed && student.RedeemedTime.HasValue)
                                            {
                                                <span>@student.RedeemedTime.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
