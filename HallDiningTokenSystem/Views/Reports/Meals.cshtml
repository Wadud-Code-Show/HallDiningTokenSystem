@model MealReportViewModel

@{
    ViewData["Title"] = "Meal Report";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Meal Report</h1>
                    <p class="text-muted mb-0">All meals, sales, and revenue details</p>
                </div>
                <div class="text-end">
                    <a href="@Url.Action("Dashboard", "Reports")" class="btn btn-outline-secondary">← Back</a>
                    <small class="text-muted d-block mt-2">Generated: @Model?.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row mb-4">
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Meals</p>
                    <h3 class="fw-bold">@Model?.TotalMeals</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Revenue</p>
                    <h3 class="fw-bold">৳@Model?.TotalRevenue.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Meals Table -->
    <div class="row">
        <div class="col-lg-12">
            @if (Model?.Meals == null || Model.Meals.Count == 0)
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3 text-muted">No Meals Found</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-bold">Meal Name</th>
                                    <th class="fw-bold">Status</th>
                                    <th class="fw-bold">Price</th>
                                    <th class="fw-bold">Capacity</th>
                                    <th class="fw-bold">Sold</th>
                                    <th class="fw-bold">Remaining</th>
                                    <th class="fw-bold">Redeemed</th>
                                    <th class="fw-bold">Revenue</th>
                                    <th class="fw-bold">Utilization</th>
                                    <th class="fw-bold">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var meal in Model.Meals)
                                {
                                    <tr>
                                        <td>
                                            <strong>@meal.MealName</strong>
                                            @if (meal.IsArchived)
                                            {
                                                <br />
                                                <span class="badge bg-secondary small">Archived</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @meal.StatusBadgeClass">@meal.Status</span>
                                        </td>
                                        <td>৳@meal.Price.ToString("N2")</td>
                                        <td>@meal.Capacity</td>
                                        <td>@meal.SoldCount</td>
                                        <td>@meal.RemainingCapacity</td>
                                        <td>@meal.RedeemedCount</td>
                                        <td><strong>৳@meal.Revenue.ToString("N2")</strong></td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar" style="width: @(meal.CapacityUtilization)%;" 
                                                     aria-valuenow="@meal.SoldCount" aria-valuemin="0" aria-valuemax="@meal.Capacity">
                                                    @meal.CapacityUtilization.ToString("N0")%
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("MealDetails", "Reports", new { id = meal.MealId })" class="btn btn-sm btn-primary">
                                                View Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
