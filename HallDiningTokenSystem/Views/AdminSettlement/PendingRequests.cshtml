@model PendingSettlementRequestsListViewModel

@{
    ViewData["Title"] = "Pending Settlement Requests";
}

<div class="container-fluid py-5">
    <div class="row mb-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold mb-2">Pending Settlement Requests</h1>
                    <p class="text-muted">Review and approve cash settlement requests from CashAdmins.</p>
                </div>
                <div>
                    <a href="@Url.Action("Dashboard", "AdminSettlement")" class="btn btn-outline-secondary">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Pending Requests</p>
                            <h3 class="fw-bold mb-0">@Model.TotalPendingCount</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Total Pending Amount</p>
                            <h3 class="fw-bold mb-0">৳@Model.TotalPendingAmount.ToString("N2")</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">CashAdmins</p>
                            <h3 class="fw-bold mb-0">@Model.Requests.Select(r => r.CashAdminId).Distinct().Count()</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-3 h-100 bg-light">
                        <div class="card-body">
                            <p class="text-muted small mb-1">As Of</p>
                            <p class="fw-bold mb-0">@Model.AsOfDate?.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Requests -->
    <div class="row">
        <div class="col-12">
            @if (Model.TotalPendingCount == 0)
            {
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center text-muted">
                        <i class="bi bi-check-circle" style="font-size: 3rem; color: #28a745;"></i>
                        <p class="mt-3 mb-0">No pending settlement requests at this time.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var request in Model.Requests.OrderByDescending(r => r.RequestedAt))
                    {
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow">
                                <div class="card-header bg-light border-0 rounded-top-3 p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="fw-bold mb-1">Request #@request.Id</h6>
                                            <p class="text-muted small mb-0">@request.CashAdminName</p>
                                        </div>
                                        <span class="badge bg-warning">@request.TimeAgoRequested</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <p class="text-muted small mb-1">Requested Amount</p>
                                        <h4 class="fw-bold mb-0">৳@request.RequestedAmount.ToString("N2")</h4>
                                    </div>

                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">Total Collected</p>
                                            <p class="fw-bold">৳@request.TotalCollectedByAdmin.ToString("N2")</p>
                                        </div>
                                        <div class="col-6">
                                            <p class="text-muted small mb-1">Already Settled</p>
                                            <p class="fw-bold">৳@request.TotalSettledByAdmin.ToString("N2")</p>
                                        </div>
                                    </div>

                                    <div class="alert alert-info small mb-3" role="alert">
                                        <i class="bi bi-info-circle"></i>
                                        <strong>Collections:</strong> @request.CollectionCount top-ups
                                    </div>

                                    @if (!string.IsNullOrEmpty(request.RequestNote))
                                    {
                                        <div class="mb-3">
                                            <p class="text-muted small mb-1">CashAdmin's Note</p>
                                            <p class="text-muted small fst-italic">@request.RequestNote</p>
                                        </div>
                                    }

                                    <div class="d-grid gap-2 d-sm-flex">
                                        <a href="@Url.Action("ApproveRequest", "AdminSettlement", new { id = request.Id })" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </a>
                                        <a href="@Url.Action("RejectRequest", "AdminSettlement", new { id = request.Id })" class="btn btn-sm btn-danger">
                                            <i class="bi bi-x-lg"></i> Reject
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Info Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-lightbulb"></i>
                <strong>Workflow Tips:</strong>
                <ul class="mb-0 mt-2">
                    <li>Verify the total collected amount matches CashAdmin records</li>
                    <li>Ensure pending amount is correctly calculated</li>
                    <li>Approve only after physical cash verification</li>
                    <li>Add notes for audit trail on approval/rejection</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
.hover-shadow {
    transition: box-shadow 0.3s ease;
}
.hover-shadow:hover {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
}
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
