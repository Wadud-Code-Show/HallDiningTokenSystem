@model SettlementRecordViewModel

@{
    ViewData["Title"] = "Settlement Details";
}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold mb-2">Settlement Record Details</h1>
                    <p class="text-muted">Complete information for Settlement #@Model.Id</p>
                </div>
                <a href="@Url.Action("SettlementHistory", "AdminSettlement")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to History
                </a>
            </div>
        </div>
    </div>

    <!-- Settlement Information -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 rounded-top-3 p-3">
                    <h5 class="fw-bold mb-0">Settlement Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Settlement ID</p>
                            <p class="fw-bold">#@Model.Id</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Status</p>
                            <p>
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Approved & Settled</span>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Amount Settled</p>
                            <p class="fw-bold" style="font-size: 1.5rem; color: #28a745;">৳@Model.Amount.ToString("N2")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Settlement Date</p>
                            <p class="fw-bold">@Model.SettlementDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">CashAdmin</p>
                            <p class="fw-bold">@Model.CashAdminName</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Received By (SuperAdmin)</p>
                            <p class="fw-bold">@Model.ReceivedByAdminName</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="mb-4">
                            <p class="text-muted small mb-1">Settlement Notes</p>
                            <div class="alert alert-light border-start border-4 border-success">
                                <p class="mb-0 text-muted">@Model.Note</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Request Information -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 rounded-top-3 p-3">
                    <h5 class="fw-bold mb-0">Related Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Settlement Type</p>
                            <p class="fw-bold">Cash Handover</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Reference Date</p>
                            <p>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction Details -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 rounded-top-3 p-3">
                    <h5 class="fw-bold mb-0">Transaction Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Created At</p>
                            <p>@Model.SettlementDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Transaction Type</p>
                            <p>Cash Settlement Handover</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Settled By</p>
                            <p class="fw-bold">@Model.CashAdminName</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted small mb-1">Received By</p>
                            <p class="fw-bold">@Model.ReceivedByAdminName</p>
                        </div>
                    </div>

                    <div class="alert alert-info small" role="alert">
                        <i class="bi bi-info-circle"></i>
                        <strong>Record Type:</strong> This is an immutable settlement record created upon approval of a settlement request.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Trail -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-0 rounded-top-3 p-3">
                    <h5 class="fw-bold mb-0">Audit Trail</h5>
                </div>
                <div class="card-body p-4">
                    <div class="timeline">
                        <div class="timeline-item mb-4">
                            <div class="d-flex">
                                <div class="timeline-marker">
                                    <i class="bi bi-check-circle text-success" style="font-size: 1.5rem;"></i>
                                </div>
                                <div class="ms-3">
                                    <p class="fw-bold mb-1">Settlement Approved and Created</p>
                                    <p class="text-muted small mb-1">@Model.SettlementDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                                    <p class="text-muted small mb-0">Amount: ৳@Model.Amount.ToString("N2")</p>
                                    <p class="text-muted small mb-0">Receiver: @Model.ReceivedByAdminName</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex gap-2 justify-content-end">
                <a href="@Url.Action("RequestAudit", "AdminSettlement")" class="btn btn-outline-secondary">
                    <i class="bi bi-list-check"></i> View Full Audit Trail
                </a>
                <a href="@Url.Action("SettlementHistory", "AdminSettlement")" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Back to Settlements
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.timeline-marker {
    width: 3rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
}

.timeline-item {
    padding-bottom: 1rem;
    border-left: 2px solid #dee2e6;
    padding-left: 1rem;
}

.timeline-item:last-child {
    border-left: none;
}
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
