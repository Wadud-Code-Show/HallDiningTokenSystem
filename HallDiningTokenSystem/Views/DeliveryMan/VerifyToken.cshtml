@model VerifyTokenViewModel

@{
    ViewData["Title"] = "Verify Student Token";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Verify Student Token</h1>
                    <p class="text-muted mb-0">@Model?.ActiveServingMeals active serving meal(s)</p>
                </div>
                <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-outline-secondary">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Main Verification Card -->
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Enter OTP Code</h5>
                </div>

                <div class="card-body p-5">
                    <form method="post" asp-action="VerifyToken">
                        <!-- OTP Input -->
                        <div class="mb-4">
                            <label for="otpCode" class="form-label fw-bold">OTP Code</label>
                            <input type="text" 
                                   id="otpCode" 
                                   name="otpCode" 
                                   class="form-control form-control-lg text-center" 
                                   placeholder="Enter 6-digit code"
                                   autocomplete="off"
                                   autofocus
                                   style="font-size: 2rem; letter-spacing: 8px; font-family: monospace;"
                                   maxlength="8" />
                            <small class="text-muted d-block mt-2">Enter the OTP code from the student's token</small>
                        </div>

                        <!-- Instructions -->
                        <div class="alert alert-info p-3 mb-4">
                            <i class="bi bi-info-circle"></i>
                            <strong>Instructions:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Ask student for their OTP code</li>
                                <li>Enter the 6-character code above</li>
                                <li>Press Enter or click Verify</li>
                                <li>System will check token validity and meal serving phase</li>
                            </ul>
                        </div>

                        <!-- Active Serving Status -->
                        @if (Model?.ActiveServingMeals > 0)
                        {
                            <div class="alert alert-success p-3 mb-4">
                                <i class="bi bi-check-circle"></i>
                                <strong>@Model.ActiveServingMeals active serving meal(s) currently available</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning p-3 mb-4">
                                <i class="bi bi-exclamation-triangle"></i>
                                <strong>No active serving meals right now</strong>
                            </div>
                        }

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-lg"></i> Verify Token
                            </button>
                            <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Recent Verifications Quick Link -->
            <div class="mt-4">
                <a href="@Url.Action("ServingHistory", "DeliveryMan")" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-clock-history"></i> View Your Serving History
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control-lg {
        min-height: 3.5rem;
    }

    .alert-info {
        background-color: #e7f3ff;
        border: 1px solid #cce5ff;
        color: #004085;
    }
</style>

<script>
    // Auto-focus on OTP input and uppercase conversion
    document.getElementById('otpCode').addEventListener('input', function (e) {
        this.value = this.value.toUpperCase();
    });

    // Submit form on Enter key (numeric mode optimization)
    document.getElementById('otpCode').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            this.form.submit();
        }
    });
</script>
