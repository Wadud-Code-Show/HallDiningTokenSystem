@model ServingDashboardViewModel

@{
    ViewData["Title"] = "Meal Serving Dashboard";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Meal Serving Dashboard</h1>
                    <p class="text-muted mb-0">DeliveryMan: @Model?.DeliveryManName</p>
                </div>
                <div class="text-end">
                    <p class="text-muted small mb-1">Current Time</p>
                    <p class="fw-bold fs-5">@Model?.CurrentTime.ToString("hh:mm tt")</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.ServingMeals == null || Model.ServingMeals.Count == 0)
    {
        <!-- No Serving Meals -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-info-circle" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3 text-muted">No Active Serving Meals</h5>
                        <p class="text-muted mb-3">Currently, there are no meals in the serving window.</p>
                        <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-primary">Refresh</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Active Serving Meals -->
        <div class="row">
            <div class="col-lg-12">
                <h5 class="fw-bold mb-3">Active Serving Meals (@Model?.ServingMeals.Count)</h5>
            </div>
        </div>

        <div class="row">
            @foreach (var meal in Model.ServingMeals)
            {
                <div class="col-lg-6 col-xl-4 mb-4">
                    <div class="card border-0 shadow-sm rounded-3 h-100">
                        <!-- Meal Header -->
                        <div class="card-header bg-light border-bottom-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-2">@meal.MealName</h6>
                                    <small class="text-muted">ID: @meal.MealId</small>
                                </div>
                                @if (meal.IsUrgent)
                                {
                                    <span class="badge bg-danger">URGENT</span>
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Time Remaining -->
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Time Remaining</small>
                                <h5 class="@meal.StatusClass fw-bold mb-0">@meal.GetTimeRemainingDisplay()</h5>
                            </div>

                            <!-- Serving Window -->
                            <div class="alert alert-info-light p-2 mb-3 small">
                                <strong>Serving Window:</strong><br />
                                @meal.ServingStart.ToString("hh:mm tt") - @meal.ServingEnd.ToString("hh:mm tt")
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Redemptions</small>
                                    <small class="fw-bold">@meal.RedeemedCount / @meal.TotalSold</small>
                                </div>
                                <div class="progress" style="height: 24px;">
                                    <div class="progress-bar @meal.ProgressBarClass" role="progressbar" 
                                         style="width: @(meal.PercentRedeemed)%;" 
                                         aria-valuenow="@meal.RedeemedCount" 
                                         aria-valuemin="0" 
                                         aria-valuemax="@meal.TotalSold">
                                        @meal.PercentRedeemed%
                                    </div>
                                </div>
                            </div>

                            <!-- Stats -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Redeemed</small>
                                    <strong class="text-success">@meal.RedeemedCount</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Remaining</small>
                                    <strong class="text-info">@meal.RemainingToRedeem</strong>
                                </div>
                            </div>

                            <!-- Verify Button -->
                            <a href="@Url.Action("VerifyToken", "DeliveryMan")" class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-check-circle"></i> Verify Token for this Meal
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Quick Actions -->
        <div class="row mt-4">
            <div class="col-lg-12">
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("VerifyToken", "DeliveryMan")" class="btn btn-primary">
                        <i class="bi bi-search"></i> Verify Student Token
                    </a>
                    <a href="@Url.Action("ServingHistory", "DeliveryMan")" class="btn btn-outline-primary">
                        <i class="bi bi-clock-history"></i> View Serving History
                    </a>
                    <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .alert-info-light {
        background-color: #e7f3ff;
        border: 1px solid #cce5ff;
        color: #004085;
    }
</style>
