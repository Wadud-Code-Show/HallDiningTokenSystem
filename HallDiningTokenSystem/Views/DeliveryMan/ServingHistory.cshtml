@model ServingHistoryViewModel

@{
    ViewData["Title"] = "Serving History";
}

<div class="container-fluid py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Serving History</h1>
                    <p class="text-muted mb-0">DeliveryMan: @Model?.DeliveryManName</p>
                </div>
                <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-outline-secondary">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form method="get" asp-action="ServingHistory" class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <label for="dateFilter" class="form-label small text-muted">Filter by Date</label>
                            <input type="date" 
                                   id="dateFilter" 
                                   name="dateFilter" 
                                   class="form-control"
                                   value="@Model?.FilterDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="d-flex gap-2 align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-funnel"></i> Filter
                            </button>
                            <a href="@Url.Action("ServingHistory", "DeliveryMan")" class="btn btn-outline-secondary">
                                Clear
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <p class="text-muted small mb-2">Total Meals Served</p>
                    <h3 class="fw-bold text-success">@Model?.TotalRedemptions</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <p class="text-muted small mb-2">Date</p>
                    <h5 class="fw-bold">@Model?.FilterDate.ToString("dd MMM yyyy")</h5>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 text-center">
                    <p class="text-muted small mb-2">Serving Staff</p>
                    <h5 class="fw-bold">@Model?.DeliveryManName</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Redemptions Table/List -->
    <div class="row">
        <div class="col-lg-12">
            @if (Model?.Redemptions == null || Model.Redemptions.Count == 0)
            {
                <!-- Empty State -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                        <h5 class="mt-3 text-muted">No Redemptions Found</h5>
                        <p class="text-muted mb-3">There are no token redemptions for this date.</p>
                        <a href="@Url.Action("VerifyToken", "DeliveryMan")" class="btn btn-primary">
                            Start Verifying Tokens
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Desktop View: Table -->
                <div class="d-none d-md-block">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="fw-bold">Served Time</th>
                                        <th class="fw-bold">OTP Code</th>
                                        <th class="fw-bold">Student Name</th>
                                        <th class="fw-bold">Student ID</th>
                                        <th class="fw-bold">Meal</th>
                                        <th class="fw-bold">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var redemption in Model.Redemptions)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@redemption.FormattedTime</strong><br />
                                                <small class="text-muted">@redemption.TimeAgo</small>
                                            </td>
                                            <td>
                                                <code class="bg-light p-2 rounded">@redemption.OtpCode</code>
                                            </td>
                                            <td>@redemption.StudentName</td>
                                            <td>
                                                <small class="text-muted">@redemption.StudentId</small>
                                            </td>
                                            <td>@redemption.MealName</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle"></i> Redeemed
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Mobile View: Cards -->
                <div class="d-md-none">
                    @foreach (var redemption in Model.Redemptions)
                    {
                        <div class="card border-0 shadow-sm rounded-3 mb-3">
                            <div class="card-body p-4">
                                <!-- Time -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Time</small>
                                    <p class="fw-bold mb-0">@redemption.FormattedTime <span class="text-muted smaller">(@redemption.TimeAgo)</span></p>
                                </div>

                                <!-- OTP -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">OTP Code</small>
                                    <code class="bg-light p-2 rounded d-block">@redemption.OtpCode</code>
                                </div>

                                <!-- Student -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Student</small>
                                    <p class="fw-bold mb-1">@redemption.StudentName</p>
                                    <small class="text-muted">ID: @redemption.StudentId</small>
                                </div>

                                <!-- Meal -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Meal</small>
                                    <p class="fw-bold mb-0">@redemption.MealName</p>
                                </div>

                                <!-- Status -->
                                <div>
                                    <span class="badge bg-success w-100 p-2">
                                        <i class="bi bi-check-circle"></i> Redeemed
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("VerifyToken", "DeliveryMan")" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Verify Another Token
                </a>
                <a href="@Url.Action("Dashboard", "DeliveryMan")" class="btn btn-outline-secondary">
                    <i class="bi bi-house"></i> Back to Dashboard
                </a>
                <button onclick="window.print()" class="btn btn-outline-secondary ms-auto">
                    <i class="bi bi-printer"></i> Print History
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f9f9f9;
    }

    code {
        font-family: 'Courier New', monospace;
        letter-spacing: 2px;
        font-size: 0.9rem;
    }

    .smaller {
        font-size: 0.85rem;
    }
</style>

<style type="text/css">
    @@media print {
        .btn, form {
            display: none;
        }

        .card {
            page-break-inside: avoid;
        }
    }
</style>
