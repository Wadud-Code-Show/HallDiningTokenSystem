@{
    ViewData["Title"] = "Hall Dining Token Management System";
}

<!-- Hero Section -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-5 fw-bold mb-3">Hall Dining Token Management System</h1>
                <p class="lead mb-3">OTP-based smart dining token and wallet management system.</p>
                <p class="text-white-50 mb-4">Students can buy meal tokens using wallet balance, and meals are verified securely using OTP.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a class="btn btn-light" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-4">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="bi bi-wallet2 text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Wallet Top-up</h5>
                        <p class="card-text text-muted small">Authorized Cash Admin adds balance to student wallet.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="bi bi-key text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">OTP Token Purchase</h5>
                        <p class="card-text text-muted small">Student buys meal tokens and receives unique OTP.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-3">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="bi bi-truck text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h5 class="card-title fw-bold">Secure Meal Delivery</h5>
                        <p class="card-text text-muted small">DeliveryMan verifies OTP and redeems token once.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Workflow Section -->
<section class="py-4 bg-light">
    <div class="container">
        <h3 class="text-center fw-bold mb-4">Simple Workflow</h3>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="text-center">
                        <div class="badge bg-primary text-white p-2 rounded-circle mb-2" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-plus" style="font-size: 1.5rem;"></i>
                        </div>
                        <p class="small fw-bold">Register/Login</p>
                    </div>
                    <div class="text-muted">→</div>
                    <div class="text-center">
                        <div class="badge bg-primary text-white p-2 rounded-circle mb-2" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-wallet2" style="font-size: 1.5rem;"></i>
                        </div>
                        <p class="small fw-bold">Wallet Top-up</p>
                    </div>
                    <div class="text-muted">→</div>
                    <div class="text-center">
                        <div class="badge bg-primary text-white p-2 rounded-circle mb-2" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-ticket-perforated" style="font-size: 1.5rem;"></i>
                        </div>
                        <p class="small fw-bold">Buy Token</p>
                    </div>
                    <div class="text-muted">→</div>
                    <div class="text-center">
                        <div class="badge bg-primary text-white p-2 rounded-circle mb-2" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-shield-check" style="font-size: 1.5rem;"></i>
                        </div>
                        <p class="small fw-bold">Verify OTP</p>
                    </div>
                    <div class="text-muted">→</div>
                    <div class="text-center">
                        <div class="badge bg-primary text-white p-2 rounded-circle mb-2" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="bi bi-file-earmark-text" style="font-size: 1.5rem;"></i>
                        </div>
                        <p class="small fw-bold">Report</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Roles Section -->
<section class="py-4">
    <div class="container">
        <h3 class="text-center fw-bold mb-4">User Roles</h3>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 text-center">
                    <div class="card-body">
                        <div class="mb-2">
                            <i class="bi bi-shield-lock text-primary" style="font-size: 1.8rem;"></i>
                        </div>
                        <h6 class="card-title fw-bold">SuperAdmin</h6>
                        <p class="card-text text-muted small">Creates meals and views reports.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 text-center">
                    <div class="card-body">
                        <div class="mb-2">
                            <i class="bi bi-person-badge text-primary" style="font-size: 1.8rem;"></i>
                        </div>
                        <h6 class="card-title fw-bold">Authorized Cash Admin</h6>
                        <p class="card-text text-muted small">Tops up student wallets and tracks cash.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 text-center">
                    <div class="card-body">
                        <div class="mb-2">
                            <i class="bi bi-person-circle text-primary" style="font-size: 1.8rem;"></i>
                        </div>
                        <h6 class="card-title fw-bold">Student</h6>
                        <p class="card-text text-muted small">Buys tokens and views wallet.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-3 text-center">
                    <div class="card-body">
                        <div class="mb-2">
                            <i class="bi bi-truck text-primary" style="font-size: 1.8rem;"></i>
                        </div>
                        <h6 class="card-title fw-bold">DeliveryMan</h6>
                        <p class="card-text text-muted small">Verifies OTP and delivers meals.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-4 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h3 class="fw-bold mb-3">Ready to manage hall dining tokens smartly?</h3>
                <div class="d-flex gap-2 justify-content-center">
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Register">Register</a>
                </div>
            </div>
        </div>
    </div>
</section>
