@{
    ViewData["Title"] = "Hall Dining Token Management System";
}

@if (!User.Identity.IsAuthenticated)
{
    <!-- PUBLIC LANDING PAGE -->

    <!-- Hero Section -->
    <section class="bg-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-5 fw-bold mb-3">Hall Dining Token Management System</h1>
                    <p class="lead mb-3">OTP-based smart dining token and wallet management system.</p>
                    <p class="text-white-50 mb-4">Students can buy meal tokens using wallet balance, and meals are verified securely using OTP.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a class="btn btn-light" asp-area="Identity" asp-page="/Account/Login">Login</a>
                        <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Register">Register</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-4">
        <div class="container">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-wallet2 text-primary" style="font-size: 2rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">Wallet Top-up</h5>
                            <p class="card-text text-muted small">Authorized Cash Admin adds balance to student wallet.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-key text-primary" style="font-size: 2rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">OTP Token Purchase</h5>
                            <p class="card-text text-muted small">Student buys meal tokens and receives unique OTP.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3">
                        <div class="card-body">
                            <div class="mb-3">
                                <i class="bi bi-truck text-primary" style="font-size: 2rem;"></i>
                            </div>
                            <h5 class="card-title fw-bold">Secure Meal Delivery</h5>
                            <p class="card-text text-muted small">DeliveryMan verifies OTP and redeems token once.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else if (User.IsInRole("SuperAdmin"))
{
    <!-- SUPERADMIN ADMIN PANEL -->

    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-shield-lock text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h1 class="fw-bold mb-2">Admin Panel</h1>
                        <p class="text-muted mb-4 lead">Manage meals, reports, and system overview from your dashboard.</p>

                        <div class="mb-3">
                            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Admin" asp-action="Dashboard">Go to Admin Dashboard</a>
                        </div>

                        <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                            <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Admin" asp-action="CreateMeal">Create Meal</a>
                            <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Admin" asp-action="Meals">View Meal List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (User.IsInRole("CashAdmin"))
{
    <!-- CASHADMIN PANEL -->

    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-person-badge text-primary" style="font-size: 3rem;"></i>
                        </div>
                        <h1 class="fw-bold mb-2">CashAdmin Panel</h1>
                        <p class="text-muted mb-4 lead">Manage student wallet top-ups and track cash collections.</p>

                        <div class="mb-3">
                            <a class="btn btn-primary btn-lg" asp-area="" asp-controller="CashAdmin" asp-action="Dashboard">Go to CashAdmin Dashboard</a>
                        </div>

                        <div class="d-flex gap-2 justify-content-center flex-wrap mt-4">
                            <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="CashAdmin" asp-action="TopUpWallet">Top-up Student Wallet</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
