@model WalletHistoryViewModel

@{
    ViewData["Title"] = "Wallet History";
}

<div class="container-fluid py-5">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">Wallet History</h1>
                    <p class="text-muted mb-0">@Model?.StudentName (@Model?.StudentId)</p>
                </div>
                <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline-secondary">
                    ← Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Current Balance Card -->
    <div class="row mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 bg-gradient" style="background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);">
                <div class="card-body p-4">
                    <p class="text-muted small mb-2">Current Wallet Balance</p>
                    <h2 class="fw-bold text-primary mb-0">৳@Model?.CurrentBalance.ToString("N2")</h2>
                    <small class="text-muted">Updated: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</small>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Quick Stats</h6>
                    <div class="row">
                        <div class="col-6">
                            <div>
                                <p class="text-muted small mb-1">Total Credits</p>
                                <p class="fw-bold text-success mb-0">
                                    ৳@(Model?.Transactions
                                        .Where(t => t.Type == "Credit")
                                        .Sum(t => t.Amount)
                                        .ToString("N2"))
                                </p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div>
                                <p class="text-muted small mb-1">Total Debits</p>
                                <p class="fw-bold text-danger mb-0">
                                    ৳@(Model?.Transactions
                                        .Where(t => t.Type == "Debit")
                                        .Sum(t => t.Amount)
                                        .ToString("N2"))
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table/List -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-light border-bottom-0">
                    <h5 class="mb-0">Transaction History</h5>
                </div>

                <div class="card-body p-0">
                    @if (Model?.Transactions == null || Model.Transactions.Count == 0)
                    {
                        <div class="p-5 text-center">
                            <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                            <h5 class="mt-3 text-muted">No Transactions</h5>
                            <p class="text-muted mb-0">Your wallet history is empty. Transactions will appear here as you purchase tokens.</p>
                        </div>
                    }
                    else
                    {
                        <!-- Desktop Table View -->
                        <div class="table-responsive d-none d-md-block">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Description</th>
                                        <th>Running Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var transaction in Model.Transactions)
                                    {
                                        <tr>
                                            <td>
                                                <small class="fw-bold">@transaction.Date.ToString("dd MMM yyyy")</small>
                                                <br />
                                                <small class="text-muted">@transaction.Date.ToString("hh:mm tt")</small>
                                            </td>
                                            <td>
                                                <span class="badge @transaction.GetTypeBadgeClass()">@transaction.Type</span>
                                            </td>
                                            <td>
                                                <span class="fw-bold @(transaction.Type == "Credit" ? "text-success" : "text-danger")">
                                                    @transaction.GetFormattedAmount()
                                                </span>
                                            </td>
                                            <td>
                                                <small>@transaction.Description</small>
                                            </td>
                                            <td>
                                                <span class="fw-bold">৳@transaction.RunningBalance.ToString("N2")</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card View -->
                        <div class="d-md-none">
                            @foreach (var transaction in Model.Transactions)
                            {
                                <div class="border-bottom p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="mb-1">@transaction.Description</h6>
                                            <small class="text-muted">@transaction.Date.ToString("dd MMM yyyy hh:mm tt")</small>
                                        </div>
                                        <span class="badge @transaction.GetTypeBadgeClass()">@transaction.Type</span>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <small class="text-muted">Amount</small>
                                            <p class="fw-bold mb-0 @(transaction.Type == "Credit" ? "text-success" : "text-danger")">
                                                @transaction.GetFormattedAmount()
                                            </p>
                                        </div>
                                        <div class="col-6 text-end">
                                            <small class="text-muted">Running Balance</small>
                                            <p class="fw-bold mb-0">৳@transaction.RunningBalance.ToString("N2")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Dashboard", "Student")" class="btn btn-primary">
                    <i class="bi bi-house"></i> Back to Dashboard
                </a>
                <a href="@Url.Action("MyTokens", "Student")" class="btn btn-outline-primary">
                    <i class="bi bi-ticket-perforated"></i> View My Tokens
                </a>
                <a href="@Url.Action("Meals", "Student")" class="btn btn-outline-secondary">
                    <i class="bi bi-bookmark-plus"></i> Purchase More Tokens
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.35rem 0.65rem;
    }
</style>
